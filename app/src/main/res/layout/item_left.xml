<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_2sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="left">
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/screen_root"
    android:layout_marginEnd="@dimen/_60sdp">
    <RelativeLayout
        android:id="@+id/msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:paddingTop="@dimen/_2sdp"
        android:paddingStart="@dimen/_4sdp">
        <ImageView
            android:id="@+id/tail"
            android:layout_width="16dp"
            android:layout_height="12dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/tail_received"/>
        <LinearLayout
            android:id="@+id/text_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/msg_left"
            android:padding="@dimen/_5sdp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/_8sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_message_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="one"
                android:textColor="@color/black"
                android:textSize="16sp"/>
            <LinearLayout
                android:layout_width="@dimen/_90sdp"
                android:layout_gravity="left"
                android:gravity="center|start"
                android:padding="@dimen/_4sdp"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/text_message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5:30 pm"
                    android:textColor="@color/leftSecondaryColor"
                    android:textSize="8sp"/>
                <TextView
                    android:id="@+id/seen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  👀"
                    android:visibility="gone"
                    android:textColor="@color/white"
                    android:textSize="8sp"/>
                <TextView
                    android:id="@+id/edited"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edited"
                    android:visibility="gone"
                    android:gravity="start"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:textColor="#80FFFFFF"
                    android:textSize="8sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/deleted_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:gravity="center"
            android:background="@drawable/msg_left"
            android:padding="@dimen/_5sdp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/_8sdp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/no_entry"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:visibility="visible"
                    android:layout_margin="@dimen/_4sdp"
                    app:tint="@color/leftSecondaryColor"
                    android:background="@android:color/transparent"
                    android:src="@drawable/no_entry_icon" />
                <TextView
                    android:id="@+id/deleted_message_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="italic"
                    android:text="You deleted this message "
                    android:textColor="@color/leftSecondaryColor"
                    android:textSize="16sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/deleted_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5:30 pm"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:layout_gravity="start"
                android:textColor="@color/leftSecondaryColor"
                android:textSize="8sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/image_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/msg_left"
            android:padding="@dimen/_5sdp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/_8sdp"
            android:orientation="vertical">
        <ImageView
            android:id="@+id/image"
            android:layout_width="@dimen/_160sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_gravity="center"
            android:scaleType="fitXY"
            android:layout_weight="2"
            app:srcCompat="@drawable/light_background"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="left"
            android:padding="@dimen/_2sdp">
            <TextView
                android:id="@+id/image_msg_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center|right"
                android:textColor="@color/leftSecondaryColor"
                android:textSize="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:text="8:40 pm" />
            <TextView
                android:id="@+id/image_seen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  👀"
                android:visibility="gone"
                android:textColor="@color/white"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/record_msg"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/msg_left"
        android:visibility="visible"
        android:padding="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:orientation="horizontal">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_weight="1"
            android:layout_margin="@dimen/_6sdp">
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/play_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/pause_icon"
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:visibility="gone"
                        app:tint="@color/iconsColor"
                        android:background="@android:color/transparent"
                        android:src="@drawable/pause_icon" />
                    <ImageView
                        android:id="@+id/play_icon"
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_20sdp"
                        app:tint="@color/iconsColor"
                        android:background="@android:color/transparent"
                        android:src="@drawable/play_icon" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/progressLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp">
                    <View
                        android:id="@+id/fullProgressView"
                        android:layout_width="match_parent"
                        android:layout_gravity="center"
                        android:layout_height="@dimen/_2sdp"
                        android:layout_centerVertical="true"
                        android:background="#D3D3D3" />

                    <View
                        android:id="@+id/listenedProgressView"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_2sdp"
                        android:layout_gravity="center|start"
                        android:layout_centerVertical="true"
                        android:background="@color/iconsColor" />
                    <View
                        android:id="@+id/thumbDot"
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_gravity="center|start"
                        android:background="@drawable/circle" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/timerTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="@dimen/_8sdp"
                    android:paddingLeft="@dimen/_4sdp"
                    android:textColor="@color/leftSecondaryColor"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:text="" />
                <TextView
                    android:id="@+id/record_msg_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center|right"
                    android:textColor="@color/leftSecondaryColor"
                    android:textSize="8sp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:text="8:40 pm" />
                <TextView
                    android:id="@+id/record_seen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="👀"
                    android:visibility="gone"
                    android:textColor="@color/white"
                    android:textSize="10sp"/>
            </LinearLayout>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/userImage"
                android:layout_width="@dimen/_37sdp"
                android:layout_height="@dimen/_37sdp"
                android:layout_gravity="center"
                android:src="@drawable/profile_ic" />

            <ImageView
                android:id="@+id/mic_icon"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="bottom|start"
                android:background="@android:color/transparent"
                android:paddingBottom="@dimen/_4sdp"
                android:src="@drawable/mic_icon"
                app:tint="@color/iconsColor" />
        </FrameLayout>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/actionBackground"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        app:cardElevation="5dp"
        android:background="@drawable/circle"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardPreventCornerOverlap="true"
        android:layout_marginLeft="@dimen/_15sdp"
        android:layout_alignBottom="@+id/msg"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_alignParentStart="true"
        android:visibility="gone"
        app:cardMaxElevation="20dp">
        <TextView
            android:id="@+id/action"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:gravity="center"
            android:text="❤"
            android:textColor="@color/white"
            android:textSize="12sp"/>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
    <View
        android:id="@+id/selectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8034C759"
        android:visibility="gone">
    </View>
</FrameLayout>