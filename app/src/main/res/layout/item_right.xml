<!-- res/layout/item_message_sent.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginStart="@dimen/_100sdp"
    android:gravity="right">

   <RelativeLayout
       android:id="@+id/msg"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:paddingBottom="@dimen/_10sdp"
       android:paddingTop="@dimen/_2sdp"
       android:paddingEnd="@dimen/_4sdp"
       >
       <ImageView
           android:id="@+id/tail"
           android:layout_width="16dp"
           android:layout_height="12dp"
           android:layout_alignParentEnd="true"
           android:layout_alignParentTop="true"
           android:src="@drawable/tail_sent"/>
       <LinearLayout
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_alignParentEnd="true"
           android:layout_alignParentTop="true"
           android:background="@drawable/msg_right"
           android:padding="@dimen/_5sdp"
           android:layout_marginEnd="@dimen/_8sdp"
           android:orientation="vertical">

           <TextView
               android:id="@+id/text_message_body"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="hello every one"
               android:textColor="@android:color/white"
               android:textSize="16sp"/>

           <LinearLayout
               android:layout_width="@dimen/_60sdp"
               android:layout_gravity="right"
               android:gravity="center|end"
               android:padding="@dimen/_4sdp"
               android:layout_height="wrap_content">
               <TextView
                   android:id="@+id/text_message_time"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="5:30 pm"
                   android:textColor="#80FFFFFF"
                   android:textSize="8sp"/>
               <TextView
                   android:id="@+id/seen"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text=" 👀"
                   android:textColor="@color/white"
                   android:textSize="12sp"/>
           </LinearLayout>
       </LinearLayout>
   </RelativeLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/actionBackground"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        app:cardElevation="5dp"
        android:background="@drawable/circle"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardPreventCornerOverlap="true"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_alignBottom="@+id/msg"
        android:layout_alignParentEnd="true"
        android:visibility="gone"
        app:cardMaxElevation="20dp">
    <TextView
        android:id="@+id/action"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:gravity="center"
        android:text="❤"
        android:textColor="@color/white"
        android:textSize="12sp"/>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>