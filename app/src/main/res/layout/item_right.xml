<!-- res/layout/item_message_sent.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="@dimen/_2sdp"
    android:gravity="right">
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
   <RelativeLayout
       android:id="@+id/msg"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:paddingBottom="@dimen/_10sdp"
       android:paddingTop="@dimen/_2sdp"
       android:paddingEnd="@dimen/_4sdp"
       >
       <ImageView
           android:id="@+id/tail"
           android:layout_width="16dp"
           android:layout_height="12dp"
           android:layout_alignParentEnd="true"
           android:layout_alignParentTop="true"
           android:src="@drawable/tail_sent"/>
       <LinearLayout
           android:id="@+id/text_msg"
           android:visibility="visible"
           android:layout_width="@dimen/_140sdp"
           android:layout_height="wrap_content"
           android:layout_alignParentEnd="true"
           android:layout_alignParentTop="true"
           android:background="@drawable/msg_right"
           android:padding="@dimen/_5sdp"
           android:layout_marginEnd="@dimen/_8sdp"
           android:orientation="vertical">

           <TextView
               android:id="@+id/text_message_body"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="one"
               android:textColor="@android:color/white"
               android:textSize="16sp"/>

           <LinearLayout
               android:layout_width="@dimen/_70sdp"
               android:layout_gravity="right"
               android:gravity="center|end"
               android:padding="@dimen/_4sdp"
               android:orientation="horizontal"
               android:layout_height="wrap_content">
               <TextView
                   android:id="@+id/text_message_time"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="5:30 pm"
                   android:textColor="#80FFFFFF"
                   android:textSize="8sp"/>
               <TextView
                   android:id="@+id/seen"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="  👀"
                   android:textColor="@color/white"
                   android:textSize="8sp"/>
           </LinearLayout>
       </LinearLayout>
       <LinearLayout
           android:id="@+id/image_msg"
           android:visibility="gone"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_alignParentEnd="true"
           android:layout_alignParentTop="true"
           android:background="@drawable/msg_right"
           android:padding="@dimen/_5sdp"
           android:layout_marginEnd="@dimen/_8sdp"
           android:orientation="vertical">
           <ImageView
               android:id="@+id/image"
               android:layout_width="@dimen/_160sdp"
               android:layout_height="wrap_content"
               android:layout_marginTop="@dimen/_4sdp"
               android:layout_gravity="center"
               android:scaleType="fitXY"
               android:layout_weight="2"
               app:srcCompat="@drawable/light_background"
               />
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal"
               android:gravity="right"
               android:padding="@dimen/_4sdp"
               android:layout_weight="1">
               <TextView
                   android:id="@+id/image_msg_time"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:gravity="center|right"
                   android:textColor="#80FFFFFF"
                   android:layout_marginEnd="@dimen/_10sdp"
                   android:text="8:40 pm" />
               <TextView
                   android:id="@+id/image_seen"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text=" 👀"
                   android:visibility="gone"
                   android:textColor="@color/white"
                   android:textSize="12sp"/>
           </LinearLayout>
       </LinearLayout>
       <LinearLayout
           android:id="@+id/record_msg"
           android:visibility="gone"
           android:layout_width="@dimen/_200sdp"
           android:layout_height="@dimen/_50sdp"
           android:layout_alignParentEnd="true"
           android:layout_alignParentTop="true"
           android:background="@drawable/msg_right"
           android:gravity="center|start"
           android:layout_marginEnd="@dimen/_8sdp"
           android:orientation="horizontal">
           <FrameLayout
               android:layout_width="@dimen/_50sdp"
               android:layout_height="@dimen/_50sdp">
               <de.hdodenhof.circleimageview.CircleImageView
                   android:id="@+id/userImage"
                   android:layout_width="@dimen/_37sdp"
                   android:layout_height="@dimen/_37sdp"
                   android:layout_gravity="center"
                   android:src="@drawable/personalphotojpg" />
               <ImageView
                   android:id="@+id/mic_icon"
                   android:layout_width="@dimen/_22sdp"
                   android:layout_height="@dimen/_22sdp"
                   app:tint="@color/iconsColor"
                   android:layout_gravity="bottom|end"
                   android:paddingBottom="@dimen/_4sdp"
                   android:background="@android:color/transparent"
                   android:src="@drawable/mic_icon" />
           </FrameLayout>
           <RelativeLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:gravity="center"
               android:layout_margin="@dimen/_4sdp">
               <LinearLayout
                   android:layout_width="match_parent"
                   android:orientation="horizontal"
                   android:gravity="center"
                   android:layout_height="match_parent">
                   <FrameLayout
                       android:id="@+id/play_record"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content">
                       <ImageView
                           android:id="@+id/pause_icon"
                           android:layout_width="@dimen/_15sdp"
                           android:layout_height="@dimen/_20sdp"
                           android:visibility="gone"
                           app:tint="@color/iconsColor"
                           android:background="@android:color/transparent"
                           android:src="@drawable/pause_icon" />
                       <ImageView
                           android:id="@+id/play_icon"
                           android:layout_width="@dimen/_15sdp"
                           android:layout_height="@dimen/_20sdp"
                           app:tint="@color/iconsColor"
                           android:background="@android:color/transparent"
                           android:src="@drawable/play_icon" />
                   </FrameLayout>
                   <FrameLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:layout_margin="@dimen/_6sdp">
                       <ProgressBar
                           android:id="@+id/voiceProgressBar"
                           style="@android:style/Widget.ProgressBar.Horizontal"
                           android:layout_width="match_parent"
                           android:layout_height="@dimen/_2sdp"
                           android:layout_margin="@dimen/_4sdp"
                           android:progress="0"
                           android:max="100"
                           android:progressDrawable="@drawable/right_progress_drawable" />
                       <View
                           android:id="@+id/thumbDot"
                           android:layout_width="@dimen/_8sdp"
                           android:layout_height="@dimen/_8sdp"
                           android:layout_gravity="center|start"
                           android:background="@drawable/circle" />
                   </FrameLayout>
               </LinearLayout>
               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_gravity="bottom"
                  android:layout_alignParentEnd="true"
                   android:layout_alignParentBottom="true"
                   android:orientation="horizontal">
                   <TextView
                       android:id="@+id/counter"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_weight="1"
                       android:gravity="center|right"
                       android:textColor="#80FFFFFF"
                       android:layout_marginEnd="@dimen/_10sdp"
                       android:text="" />
                   <TextView
                       android:id="@+id/record_msg_time"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_weight="1"
                       android:gravity="center|right"
                       android:textColor="#80FFFFFF"
                       android:textSize="@dimen/_10sdp"
                       android:layout_marginEnd="@dimen/_10sdp"
                       android:text=" " />
                   <TextView
                       android:id="@+id/record_seen"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_weight="0.5"
                       android:text="👀"
                       android:visibility="gone"
                       android:textColor="@color/white"
                       android:textSize="10sp"/>
               </LinearLayout>
           </RelativeLayout>
       </LinearLayout>
   </RelativeLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/actionBackground"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        app:cardElevation="5dp"
        android:background="@drawable/circle"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardPreventCornerOverlap="true"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_alignBottom="@+id/msg"
        android:layout_alignParentEnd="true"
        android:visibility="gone"
        app:cardMaxElevation="20dp">
        <TextView
            android:id="@+id/action"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:gravity="center"
            android:text="❤"
            android:textColor="@color/white"
            android:textSize="12sp"/>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
    <View
        android:id="@+id/selectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8034C759"
        android:visibility="gone">
    </View>
</FrameLayout>