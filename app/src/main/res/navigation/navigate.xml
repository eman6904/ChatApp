<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigate"
    app:startDestination="@id/signUp">

    <fragment
        android:id="@+id/users"
        android:name="com.example.chatapp.ui.userInterface.ui.fragments.Users"
        android:label="fragment_face"
        tools:layout="@layout/users" >
    </fragment>
    <fragment
        android:id="@+id/signIn"
        android:name="com.example.chatapp.ui.userInterface.ui.fragments.SignIn"
        android:label="SignIn" >
        <action
            android:id="@+id/action_signIn_to_users"
            app:destination="@id/users" />
        <action
            android:id="@+id/action_signIn_to_home2"
            app:destination="@id/home2" />
    </fragment>
    <fragment
        android:id="@+id/signUp"
        android:name="com.example.chatapp.ui.userInterface.ui.fragments.SignUp"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up" >
        <action
            android:id="@+id/action_signUp_to_signIn"
            app:destination="@id/signIn" />
    </fragment>
    <fragment
        android:id="@+id/profile3"
        android:name="com.example.chatapp.ui.userInterface.ui.fragments.Profile"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profile3_to_users"
            app:destination="@id/users" />
    </fragment>
    <fragment
        android:id="@+id/chat"
        android:name="com.example.chatapp.ui.userInterface.ui.fragments.Chat"
        android:label="fragment_chat"
        tools:layout="@layout/fragment_chat" >
        <action
            android:id="@+id/action_chat_to_users"
            app:destination="@id/users" />
    </fragment>
    <fragment
        android:id="@+id/home2"
        android:name="com.example.chatapp.ui.userInterface.ui.fragments.Home"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_home2_to_chat"
            app:destination="@id/chat" />
        <action
            android:id="@+id/action_home2_to_profile3"
            app:destination="@id/profile3" />
    </fragment>
</navigation>